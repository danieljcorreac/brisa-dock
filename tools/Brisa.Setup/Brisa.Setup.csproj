<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Brisa-Setup</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>../../src/Brisa.WinUI/Assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/Brisa.WinUI/Assets/Branding/AppIcon.png" LogicalName="Brisa.Icon.png" />
    <ProjectReference Include="../../src/Brisa.Core/Brisa.Core.csproj" />
    <EmbeddedResource Include="$(BrisaPayloadZip)" LogicalName="Brisa.Payload.zip" Condition="Exists('$(BrisaPayloadZip)')" />
  </ItemGroup>
</Project>
